# Dependencies
frontend/node_modules/
backend/.venv/
backend/venv/

# Build output
# ВАЖНО: frontend/dist НЕ игнорируем! Деплой (deploy-vps.sh) тянет собранный фронт
# из git через `git reset --hard` — сервер сам НЕ собирает. Если игнорировать
# dist/assets, index.html ссылается на несуществующий JS-бандл и сайт падает.
*.tsbuildinfo

# Python cache
__pycache__/
*.pyc
*.pyo

# Local sandbox data (a copy of real data — never commit)
backend/data/

# Temp / scratch
.tmp_render.*
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
